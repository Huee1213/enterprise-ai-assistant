# ===========================================
# Enterprise AI Knowledge Assistant
# Environment Configuration
# ===========================================

# --- LLM Configuration (via LiteLLM) ---
# Provider: "openai" (default), "azure", "anthropic", "deepseek", etc.
LLM_PROVIDER=openai

# Model name (supports OpenAI, DeepSeek, etc. via LiteLLM)
LLM_MODEL=gpt-4o-mini

# API Key - REQUIRED for LLM to work
LLM_API_KEY=sk-your-key-here

# API Base URL (change for different providers)
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
LLM_API_BASE=https://api.openai.com/v1

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# --- JWT Authentication ---
# REQUIRED: Generate with: openssl rand -hex 32
# 国内用户可用: echo %RANDOM%%RANDOM%%RANDOM%%RANDOM% | md5sum
JWT_SECRET_KEY=your-32-byte-hex-secret-here

# --- Embedding Configuration ---
EMBEDDING_MODEL=text-embedding-3-small
# Leave empty to use LLM_API_KEY
EMBEDDING_API_KEY=

# --- Vector Database ---
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=enterprise_knowledge

# --- Hugging Face Mirror (国内加速) ---
# 国内用户设置后可加速本地嵌入模型下载
# Linux/Mac: export HF_ENDPOINT=https://hf-mirror.com
# Windows: set HF_ENDPOINT=https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# --- Document Processing ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K=5
SCORE_THRESHOLD=0.5
